# Verdict (verdict-1.4), loaded in process with PyTorch. No vLLM. Build docker/Dockerfile.base first.
#   docker build -f docker/Dockerfile.verdict -t zeus-verdict .
ARG BASE_IMAGE=zeus-base:cu130-torch2.13
FROM ${BASE_IMAGE}

ENV ZEUS_BACKEND=verdict ZEUS_HOST=0.0.0.0 ZEUS_PORT=8080
WORKDIR /app
COPY pyproject.toml README.md ./
COPY zeus ./zeus
RUN uv pip install --python /opt/venv/bin/python --no-cache ".[verdict]"

EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=300s \
    CMD curl -sf http://127.0.0.1:8080/health || exit 1
ENTRYPOINT []
CMD ["python", "-m", "zeus"]
